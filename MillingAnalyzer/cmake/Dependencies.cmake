cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED ROOT)
 get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/../../build-bezier-viewer-deps" ABSOLUTE)
endif()
find_program(GIT git REQUIRED)
function(run)
 execute_process(COMMAND ${ARGV} RESULT_VARIABLE result)
 if(NOT result EQUAL 0)
  message(FATAL_ERROR "Dependency command failed: ${ARGV}")
 endif()
endfunction()
function(source name url tag revision)
 if(NOT EXISTS "${ROOT}/${name}/.git")
  run("${GIT}" clone --depth 1 --branch "${tag}" "${url}" "${ROOT}/${name}")
 endif()
 execute_process(COMMAND "${GIT}" -C "${ROOT}/${name}" rev-parse HEAD OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE)
 if(NOT head STREQUAL revision)
  message(FATAL_ERROR "Unexpected revision in ${name}; choose a fresh ROOT")
 endif()
 execute_process(COMMAND "${GIT}" -C "${ROOT}/${name}" status --porcelain OUTPUT_VARIABLE dirty)
 if(dirty)
  message(FATAL_ERROR "Local changes in dependency ${name}; nothing overwritten")
 endif()
endfunction()
file(MAKE_DIRECTORY "${ROOT}")
source(eigen https://gitlab.com/libeigen/eigen.git 3.4.0 3147391d946bb4b6c68edd901f2add6ac1f31f8c)
if(NOT EXISTS "${ROOT}/occt/installed-7.9.3.txt")
 source(occt-src https://github.com/Open-Cascade-SAS/OCCT.git V7_9_3 a016080bf6738d6aeae020badee4e888ad1540a5)
 set(generator)
 if(WIN32)
  set(generator -G "Visual Studio 17 2022" -A x64)
 endif()
 run("${CMAKE_COMMAND}" -S "${ROOT}/occt-src" -B "${ROOT}/occt-build" ${generator}
  -DCMAKE_BUILD_TYPE=Release "-DCMAKE_INSTALL_PREFIX=${ROOT}/occt"
  -DBUILD_MODULE_FoundationClasses=OFF -DBUILD_MODULE_ModelingData=OFF -DBUILD_MODULE_ModelingAlgorithms=OFF -DBUILD_MODULE_ApplicationFramework=OFF -DBUILD_MODULE_DataExchange=OFF -DBUILD_MODULE_DETools=OFF "-DBUILD_ADDITIONAL_TOOLKITS=TKDESTEP TKMesh TKPrim" -DBUILD_MODULE_Visualization=OFF -DBUILD_MODULE_Draw=OFF -DUSE_TK=OFF -DUSE_FREETYPE=OFF -DUSE_TBB=OFF -DBUILD_DOC_Overview=OFF)
 run("${CMAKE_COMMAND}" --build "${ROOT}/occt-build" --config Release --parallel 4)
 run("${CMAKE_COMMAND}" --install "${ROOT}/occt-build" --config Release)
 file(WRITE "${ROOT}/occt/installed-7.9.3.txt" "a016080bf6738d6aeae020badee4e888ad1540a5\n")
endif()
message(STATUS "Use -DCMAKE_PREFIX_PATH=${ROOT}/occt -DEIGEN_INCLUDE_DIR=${ROOT}/eigen")
